# Advanced Scientific Calculator Environment Configuration
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=replace-with-a-robust-random-secret-key-in-production
PORT=5000
HOST=0.0.0.0

# Security & Calculation Limits
CALC_TIMEOUT_SECONDS=5
MAX_EXPRESSION_LENGTH=500
MAX_MATRIX_DIMENSION=6
MAX_SERIES_ORDER=15
